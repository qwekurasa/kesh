	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>io.github.qwekurasa.kesh</string>
			<key>CFBundleURLSchemes</key>
			<array><string>kesh</string></array>
		</dict>
	</array>
</dict>
</plist>
